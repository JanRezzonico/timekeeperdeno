{
  "imports": {
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@^7.0.0",
    "@prisma/client": "npm:@prisma/client@^7.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.16",
    "@zod/zod": "jsr:@zod/zod@^4.1.13",
    "dotenv": "npm:dotenv@^17.2.3",
    "prisma": "npm:prisma@^7.0.0",
    "prismaclient": "./prisma/generated/client.ts",
    "hono": "jsr:@hono/hono@^4.10.6"
  },
  "permissions": {
    "default": {
      "env": true,
      "read": true,
      "net": true,
      "sys": ["hostname"]
    }
  },
  "tasks": {
    "dev": "deno run -P --watch main.ts",
    "test": "deno test -P",
    "start": "deno run -P main.ts"
  }
}
